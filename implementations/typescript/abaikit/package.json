{
	"name": "@abaigram/abaikit",
	"version": "0.1.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jjbits/abai.git",
		"directory": "implementations/typescript/abaikit"
	},
	"description": "The abai authoring tool: learnabai, check, new, abaify and run; itself an abaigram",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"abaikit": "./dist/bin.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": ["dist", "abai", "abaigram.yaml", "examples"],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run"
	},
	"dependencies": {
		"@abaigram/embedded-harness": "0.1.0",
		"@abaigram/stub": "0.1.0"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}

{
	"name": "abai-embedded-harness",
	"version": "0.1.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jjbits/abai.git",
		"directory": "implementations/typescript/abai-embedded-harness"
	},
	"description": "The abai harness for TypeScript: the agent side of the abaigrammar, as a library and a sidecar binary",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"abai-embedded-harness": "./dist/bin.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": ["dist"],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run"
	},
	"dependencies": {
		"@arx-06/agent": "0.87.1",
		"@arx-06/ai": "0.87.1",
		"abai": "0.1.0",
		"typebox": "1.3.27"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
